<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>蓝牙钥匙</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>7.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>7.0</string>
	<key>CFBundleVersion</key>
	<string>70</string>

	<!-- 蓝牙权限说明：与功能一致，用户可理解 -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>需要使用蓝牙与车辆蓝牙钥匙模块通信，完成认证后控制车门与点火。</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>需要使用蓝牙与车辆蓝牙钥匙模块通信，完成认证后控制车门与点火。</string>

	<!-- 原 App 声明了 bluetooth-central 以支持后台常驻（靠近解锁） -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>location</string>
	</array>

	<!-- 控制中心 / 锁屏控件通过 URL 唤起 App 执行车控
	     （控件声明在 Widget 扩展，业务逻辑只能在主 App，见 VehicleControlWidget） -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.mmxisme.gkuiblekey</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>gkuiblekey</string>
			</array>
		</dict>
	</array>

	<!-- ★ Live Activity —— 不只是展示，是后台蓝牙权限的开关
	     Apple Core Bluetooth 文档（iOS 26+）：App 有 CBManager 实例并启动
	     Live Activity 后，后台可获得与前台相同的 BLE 权限，尤其是后台扫描时
	     AllowDuplicates 仍然生效（不被系统合并成十几秒一次）。
	     没有它，预认证的 29 秒节奏在后台必然跑不准。 -->
	<key>NSSupportsLiveActivities</key>
	<true/>

	<!-- BLE 扫描在部分系统版本/机型上需要位置权限；后台保持连接亦需要 -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>扫描附近的车辆蓝牙钥匙模块需要位置权限。</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>需要在后台保持与车辆的蓝牙连接，以实现靠近解锁。</string>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>bluetooth-le</string>
	</array>
</dict>
</plist>
